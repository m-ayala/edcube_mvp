{
  "name": "edcube-firestore-rules-tests",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Security-rules tests for frontend/firestore.rules. Separate package so the app's dependencies and lockfile are untouched.",
  "scripts": {
    "test": "firebase emulators:exec --only firestore --project demo-edcube --config firebase.rules-test.json \"node --test\"",
    "test:against-running-emulator": "node --test"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "firebase": "^12.7.0",
    "firebase-tools": "^15.0.0"
  }
}
