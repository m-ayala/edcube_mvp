rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Org resolution ───────────────────────────────────────────────────
    // Single source of truth is the Users/{orgId} doc itself
    // ({ name, domains: [...], allowed_emails: [...] }) -- the same registry
    // backend/firebase/org_registry.py reads, no hardcoded domain list here
    // (tasks/firestore-reorg-spec.md Round 2, section A, overrides the Round 1
    // version of this file). An email belongs to orgId if its lowercased
    // domain is in that org's `domains`, OR the full lowercased email is in
    // `allowed_emails`. No match -> not a member; there is no default org.
    function callerEmail() {
      return request.auth.token.email.lower();
    }

    function callerEmailDomain() {
      return callerEmail().split('@')[1];
    }

    function isOrgMember(orgId) {
      return request.auth != null
          && request.auth.token.email != null
          && exists(/databases/$(database)/documents/Users/$(orgId))
          && (
               callerEmailDomain() in get(/databases/$(database)/documents/Users/$(orgId)).data.get('domains', [])
               || callerEmail() in get(/databases/$(database)/documents/Users/$(orgId)).data.get('allowed_emails', [])
             );
    }

    // ── Space membership via the `org` custom claim (TASK-028) ───────────
    // The backend (POST /api/account/bootstrap) sets the custom claim
    // `org: "<orgId>" | "personal"` after verifying the email. OR'd with the
    // domain-based isOrgMember above so existing org users keep working.
    // (Org members also have a personal workspace; they reach it through the
    // backend, which resolves the X-EdCube-Workspace header, and through the
    // Users/personal/teachers/{uid} doc checked in isPersonalOwner below.)
    function inSpace(orgId) {
      return request.auth != null
          && request.auth.token.email_verified == true
          && request.auth.token.get('org', null) == orgId;
    }

    // Access to a REAL org's data (domain match or claim). The reserved
    // personal workspace is excluded on purpose: it has its own, stricter block
    // (Firestore ORs overlapping matches, so the generic rules below must
    // never apply to Users/personal).
    function orgAccess(orgId) {
      return orgId != 'personal' && (isOrgMember(orgId) || inSpace(orgId));
    }

    // Personal-workspace helper: the `org` claim is "personal" (non-org users),
    // or the caller has a personal teachers doc (org members, whose claim is
    // their org id).
    function inPersonal() {
      return inSpace('personal')
          || (request.auth != null
              && request.auth.token.email_verified == true
              && exists(/databases/$(database)/documents/Users/personal/teachers/$(request.auth.uid)));
    }

    // ── EdCube (platform-wide knowledge base) ───────────────────────────
    // Seeded only via backend/scripts/seed_knowledge_base.py; read-only for
    // any authenticated user, never writable from clients.
    // EdCube/platform_config (plan limits, trial length, feature flags): backend
    // writes only, no client access (the app reads it through the API).
    match /EdCube/platform_config {
      allow read, write: if false;
    }

    match /EdCube/knowledge_base {
      allow read: if request.auth != null;

      match /{category}/{docId} {
        allow read: if request.auth != null;
      }
    }

    // ── Accounts (TASK-031) ─────────────────────────────────────────────
    // Written by the backend only (Admin SDK bypasses rules). A user may read
    // their own account doc (plan, trial dates, credits, status).
    match /Accounts/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Admin change log: backend only, no client access at all.
    match /AdminAudit/{entry} {
      allow read, write: if false;
    }

    // Cost log (TASK-034): one row per AI action, backend only, no client access at all.
    match /UsageLog/{entry} {
      allow read, write: if false;
    }

    // Paid-plan interest list (TASK-032): backend only, no client access at all.
    match /PaidWaitlist/{entry} {
      allow read, write: if false;
    }

    // View-only share links (TASK-036): the doc id IS the secret token, so no client may read, list
    // or write them. The public viewer goes through GET /api/share/{token} on the backend.
    match /ShareLinks/{token} {
      allow read, write: if false;
    }

    // Signup-domain aggregate (TASK-039): counts per email domain, read through the admin API only.
    match /Domains/{domain} {
      allow read, write: if false;
    }

    // Future org domain verification (TASK-039): uids and course ids, backend only.
    match /OrgDomainClaims/{claimId} {
      allow read, write: if false;
    }

    // Course invites (TASK-036): hold invitee emails and secret tokens; backend only.
    match /Invites/{inviteId} {
      allow read, write: if false;
    }

    // ── Users/personal (reserved personal workspace, TASK-028; was Users/public) ──
    // Members are identified by the `org == "personal"` claim or a personal
    // teachers doc (this doc has no domains). Stricter than orgs: private
    // courses stay private, a user can only see their own teachers doc, and
    // usage is backend-only. Plans live on Accounts/{uid}.
    match /Users/personal {
      allow read: if inPersonal();

      match /curricula/{curriculumId} {
        // TASK-036: owner or someone in sharedWithUids only. The old "isPublic = visible to all EdCube
        // users" read is gone; strangers see a course only through a view-only link (backend route).
        allow read: if inPersonal()
                    && (resource.data.teacherUid == request.auth.uid
                        || request.auth.uid in resource.data.get('sharedWithUids', []));
        // Sharing state is written by the backend only (it enforces the owner's plan and the
        // collaborator cap), so a client can neither add collaborators nor hand the course to someone.
        allow create: if inPersonal()
                      && request.resource.data.teacherUid == request.auth.uid
                      && request.resource.data.get('sharedWith', []).size() == 0
                      && request.resource.data.get('sharedWithUids', []).size() == 0;
        allow update: if inPersonal()
                      && resource.data.teacherUid == request.auth.uid
                      && request.resource.data.teacherUid == resource.data.teacherUid
                      && !request.resource.data.diff(resource.data).affectedKeys()
                            .hasAny(['sharedWith', 'sharedWithUids']);
        allow delete: if inPersonal()
                      && resource.data.teacherUid == request.auth.uid;
      }

      match /teacher_profiles/{uid} {
        allow read: if inPersonal();
        allow write: if inPersonal() && request.auth.uid == uid;
      }

      // Self only. `plan` / `plan_updated_at` are backend-written (admin SDK
      // bypasses rules). No client delete: deleting would reset a plan on re-bootstrap.
      match /teachers/{teacherUid} {
        allow read: if inPersonal() && request.auth.uid == teacherUid;
        allow create: if inPersonal() && request.auth.uid == teacherUid
                      && !('plan' in request.resource.data)
                      && !('plan_updated_at' in request.resource.data);
        allow update: if inPersonal() && request.auth.uid == teacherUid
                      && !request.resource.data.diff(resource.data).affectedKeys()
                            .hasAny(['plan', 'plan_updated_at']);

        // `{sub}/{rest=**}` (not `{subPath=**}`): a bare recursive wildcard also matches
        // the teachers doc itself (zero segments) and would OR-bypass the plan guard above.
        match /{sub}/{rest=**} {
          allow read, write: if inPersonal() && request.auth.uid == teacherUid;
        }
      }

      match /notifications/{notifId} {
        allow read, delete: if inPersonal()
                      && resource.data.toUid == request.auth.uid;
      }

      // usage/** (and anything else): no client access.
    }

    // ── Users/{orgId} (per-organization data) ───────────────────────────
    match /Users/{orgId} {
      allow read: if orgAccess(orgId);

      // ── Curricula ──────────────────────────────────────────────────────
      match /curricula/{curriculumId} {
        // Any org member can read (for public course browsing within the org)
        allow read: if orgAccess(orgId);
        // Only the owning teacher can write
        allow create: if orgAccess(orgId)
                      && request.resource.data.teacherUid == request.auth.uid;
        allow update, delete: if orgAccess(orgId)
                      && resource.data.teacherUid == request.auth.uid;
      }

      // ── Teacher profiles ─────────────────────────────────────────────
      match /teacher_profiles/{uid} {
        allow read: if orgAccess(orgId);
        allow write: if orgAccess(orgId) && request.auth.uid == uid;
      }

      // ── Teachers (legacy profile doc + folders) ─────────────────────
      match /teachers/{teacherUid} {
        // Any org member can read a teacher profile (for profile pages)
        allow read: if orgAccess(orgId);
        // Only the teacher themselves can write their profile
        allow write: if orgAccess(orgId) && request.auth.uid == teacherUid;

        // ── Resource Library (private — owner only) ───────────────────
        match /libraryFolders/{folderId} {
          allow read, write: if orgAccess(orgId) && request.auth.uid == teacherUid;
        }

        // ── Course Folders (private — owner only) ─────────────────────
        match /courseFolders/{folderId} {
          allow read, write: if orgAccess(orgId) && request.auth.uid == teacherUid;
        }
      }

      // ── Notifications (delete-on-seen inbox) ────────────────────────
      // Created by the backend via the Admin SDK (which bypasses these
      // rules); clients only ever read their own and delete-on-seen.
      match /notifications/{notifId} {
        allow read, delete: if orgAccess(orgId)
                      && resource.data.toUid == request.auth.uid;
      }

      // ── Synopsis (camp + afterschool admin/teacher views) ───────────
      // Writes go through the backend (Admin SDK); clients only read.
      match /synopsis/{synDoc} {
        allow read: if orgAccess(orgId);

        match /{document=**} {
          allow read: if orgAccess(orgId);
        }
      }
    }

  }
}
